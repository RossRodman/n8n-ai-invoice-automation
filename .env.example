# --- n8n -----------------------------------------------------------------
# Encrypts the credentials stored in n8n (openssl rand -hex 32). If unset,
# n8n generates one inside its data volume. Set it to move or back up the
# data: losing it means re-entering every credential.
# N8N_ENCRYPTION_KEY=

N8N_PORT=5678

# --- web UI --------------------------------------------------------------
INVOICE_WEB_PORT=8080

# Shared secret between the web UI and the API webhooks (openssl rand -hex 24).
# Put the same value in n8n's "Invoice API key" Header Auth credential.
INVOICE_API_KEY=

# Time zone for dates written to the sheet.
GENERIC_TIMEZONE=Europe/Kyiv
TZ=Europe/Kyiv

# --- workflow settings ---------------------------------------------------
# The workflow reads these through $env. Credentials (Gmail, Google Sheets,
# OpenAI, Slack) are not set here: create them in the n8n UI.

# Which emails count as invoices. Processed ones get a label and drop out.
INVOICE_GMAIL_QUERY=has:attachment filename:pdf -label:invoices/processed -label:invoices/review

# The Google Sheet's id, from its URL: docs.google.com/spreadsheets/d/<id>/edit
INVOICE_SHEET_ID=

INVOICE_OPENAI_MODEL=gpt-5-mini

# Below this extraction confidence (0-1), an invoice goes to manual review.
INVOICE_MIN_CONFIDENCE=0.8

INVOICE_SLACK_CHANNEL=#invoices
INVOICE_SLACK_REVIEW_CHANNEL=#invoices-review
